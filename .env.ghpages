# GitHub Pages 演示构建配置
# 页面地址：https://<用户名>.github.io/crm-system/
# 纯静态部署，无后端，因此强制启用前端模拟数据

VITE_NODE=ghpages
VUE_APP_NODE=ghpages

# 构建产物基础路径（必须与仓库名一致）
VITE_APP_BASE_URL=/crm-system/

# 系统编码（与本地演示保持一致）
VITE_APP_SYSTEM_CODE=/6666

# 微应用名称（qiankun 注册用）
VITE_APP_NAME=mx-crm

# 请求前缀（Mock 接管，不会真正发出请求）
VITE_PROXY_PATH=/apis

# 强制启用前端模拟数据
VITE_USE_MOCK=true

# 独立运行时不需要跳转外部登录页
VITE_LOGIN_URL='#/'
VITE_HOME_URL='#/6666/home/index'

VITE_APP_HELP_URL=''
VITE_CUSTOM_ICON_PATH=''
VITE_ASSOCIATED_APPROVAL_CODE=''
