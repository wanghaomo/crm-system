:root {
    --border: var(--base-grey5);
     /* drawer边框颜色 */
    --draw-border: #e2e2e2;
    /* 纯黑 */
    --black-color: #000000;
    /* 基础黑色 */
    --base-black: #333333;
    /* 基础白色 */
    --base-white: #ffffff;
    /* 基础灰色 */
    --base-grey: #999999;
    /* 基层灰色2 */
    --base-grey2: #666666;
    /* 基层灰色3 */
    --base-grey3: #f5f5f5;
    /* 基层灰色4 */
    --base-grey4: #333333;
    /* 基层灰色5 */
    --base-grey5: #d9d9d9;
    /* 基层灰色6 */
    --base-grey6: #8c8c8c;
     /* 基层灰色7 */
    --base-grey7: #bfbfbf;
     /* 基层灰色8 */
    --base-grey8: #ECEEF4;
     /* 基层灰色9 */
    --base-grey9: #F8F8F8;
    /* 主体色 */
    --base-color: #2c65f2;
    /* 主体青色  */
    --base-color2: #2fccba;
    /* border-灰色 */
    --base-border-grey: #dddfe6;
   /* 基础高亮背景色f */
    --base-highlight-bg: #ECF1FC;
    /* 基础红色 */
    --base-color-red: #E34242;
    --base-border-color-red: #FFAAAA;
    --blue-color: #3370EB;
    --base-border-color-blue: #ADC3EF;
}

/* 宽高等公共变量 */
:root {
    /* 基础宽度16px */
    --base-width-16: 16px;
    /* 基础宽度20px */
    --base-width: 20px;
    /* 基准间距 */
    --base-padding: 12px;
    /* 基础宽度10px */
    --width-10: 10px;
    /* 基准圆角 */
    --base-radius: 12px;
    /* 基准圆角8px */
    --base-radius-8: 8px;
    /* app基准间距 */
    --app-base-padding: 16px;
    /* 系统头部高度 */
    --web-header-height: 56px;
    /* app头部高度 */
    --app-header-height: 44px;
    /* 通用间距 */
    --base-padding-16: 16px;
    /* 基础字体大小14 */
    --base-font-size: 14px;
}

/* tag背景、边框、字体颜色 */
:root {
    /* success */
    --web-success-tag-bg: #f0f9eb;
    --web-success-tag-border: #e2f4d8;
    --web-success-tag-c: #2C65F2;
    /* default */
    --web-default-tag-bg: #f0f0f0;
    --web-default-tag-border: #dddfe6;
    --web-default-tag-c: #999999;
    /* warning */
    --web-warning-tag-bg: #fff1d9;
    --web-warning-tag-border: #ffe49a;
    --web-warning-tag-c: #cb8424;
    /* error */
    --web-error-tag-bg: #f8e5e2;
    --web-error-tag-border: #ffd2cc;
    --web-error-tag-c: #E34242;
    /* info */
    --web-info-tag-bg: #eff4ff;
    --web-info-tag-border: #d9e3f5;
    --web-info-tag-c: #4db16b;
    /* 默认按钮参数 */
    --web-default-button-bg: transparent;
    --web-default-button-border: #dddfe6;
    --web-default-button-c: #666666;
}
